# ---------- OS junk ----------
.DS_Store
Thumbs.db

# ---------- Crashlytics generated file ----------
crashlytics-build.properties
sysinfo.txt

# ---------- Exports (don't ship into git) ----------
*.apk
*.aab
*.ipa
*.unitypackage

# ---------- Unity Package Manager: keep packages.json + lock ----------
# Packages/manifest.json is committed; packages-lock.json is committed
# both are tiny and let the project restore deterministically
