# ---------- Workspace-wide ----------
# Downloaded asset packs are 700 MB and live OUTSIDE the git repo on purpose.
# They're a local cache — re-downloadable from Quaternius / Kenney / Mixamo anytime
# (see docs/ASSETS.md for the canonical checklist).
RawAssets/
assets-mailbox/

# Unity WebGL build output (generated by Unity Build workflow, lives in web-hosting/)
web-hosting/Build/
web-hosting/TemplateData/
web-hosting/index.html

# ---------- OS / IDE noise ----------
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/
*.swp
.env
.env.*
!.env.example

# ---------- Editor temp ----------
*.bak

# ---------- Unity noise (regenerable cache; never commit) ----------
unity-project/Library/
unity-project/Temp/
unity-project/obj/
unity-project/Builds/
unity-project/Logs/
unity-project/UserSettings/
unity-project/.idea/
unity-project/.vs/
unity-project/.vscode/

# Unity-generated solution / project files (regenerated on every open).
# Scope by location so tools/compile-check/GDGGo.CompileCheck.csproj (a real
# checked-in project file) is not caught by the *.csproj rule.
unity-project/*.csproj
unity-project/*.sln
unity-project/*.suo
unity-project/*.unityproj
unity-project/**/*.user
unity-project/**/*.tmpproj
unity-project/**/*.tss

# Unity build artifacts emitted at repo root by some setups
Builds/
web-hosting/dist/
web-hosting/node_modules/
web-hosting/public/Build/
web-hosting/public/TemplateData/
web-hosting/public/index.html
unity-project/Build/

# Build report
_LAST_BUILD_REPORT*

# compile-check NuGet cache
tools/compile-check/obj/
tools/compile-check/bin/
